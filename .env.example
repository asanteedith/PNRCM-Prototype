# PNRCM environment configuration (example). Copy to .env and fill in.
# Do NOT commit real secrets.

# Database path (defaults to <app_dir>/pnrcm_demo.db)
# PNRCM_DB=pnrcm_demo.db

# Auth mode: leave unset/empty for demo (anonymous allowed); set to 1 for secure mode
# (requires authenticated, known users; rejects anonymous on protected mutations)
# PNRCM_SECURE_MODE=0

# Secret key (REQUIRED when PNRCM_SECURE_MODE=1). Use a long random value.
# PNRCM_SECRET_KEY=

# Rate limiting: 1 = enabled (default), 0 = disabled (load testing only)
# PNRCM_RATE_LIMIT=1

# Server port
# PORT=5000